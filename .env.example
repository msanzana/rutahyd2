APP_NAME="RutaHD2 API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
# Clave aleatoria de firma JWT: mínimo 32 bytes, distinta de APP_KEY y de contraseñas.
RUTAHD_JWT_SECRET=
# Hash irreversible de contraseñas; usar argon2id si PHP lo soporta.
HASH_DRIVER=argon2id
FRONTEND_ORIGIN=http://localhost:5173
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rutahyd2_es_local
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
DTE_API_URL=
DTE_API_TOKEN=

# Habilitar invitación de usuarios y recuperación SOLO con SMTP real en servidor privado.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Ruta H&D2"
